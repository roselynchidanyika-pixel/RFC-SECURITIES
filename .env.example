# RFC SECURITIES - optional configuration.
# Copy to .env and fill in. Everything is optional; the app runs without it.

# Authoritative USD->ZWL feed (JSON with "rate", e.g. an RBZ/interbank endpoint).
# When set, the FX ticker shows a LIVE USD/ZWL rate from this source.
# When unset, USD/ZWL shows DATA UNAVAILABLE/STALE rather than a made-up number.
RFC_ZWL_API=

# SMTP (use only if you want in-app Gmail sending instead of the Gmail deep-link).
RFC_GMAIL_USER=
RFC_GMAIL_PASS=

# Contact defaults for the report footer / WhatsApp number.
RFC_PHONE=263777479118
RFC_EMAIL=chidanyikaroselyn@gmail.com
RFC_LOCATION=Mashava, Masvingo